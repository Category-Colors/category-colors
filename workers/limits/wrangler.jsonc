{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Rate limits for the MCP server, set in index.js. Pages Functions can't
  // define Durable Objects, so this Worker holds them and the site calls it
  // over a service binding (LIMITS in the root wrangler.jsonc). Deploy it
  // before the site.
  "name": "category-colors-limits",
  "main": "index.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "durable_objects": { "bindings": [{ "name": "COUNTERS", "class_name": "Counter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }]
}
