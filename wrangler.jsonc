{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "category-colors",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-07",
  // MCP_ENABLED: anything but "true" turns /mcp into a 404
  "vars": { "WEATHER_NON_COMMERCIAL": "true", "MCP_ENABLED": "true" },
  // Needs Workers Paid. A 20-color generation takes about 1.2 s of CPU; this
  // stops anything that runs far past that.
  "limits": { "cpu_ms": 5000 },
  // Rate limits for /mcp, held by workers/limits
  "services": [{ "binding": "LIMITS", "service": "category-colors-limits" }]
}
